+function waveD(y) {
+  const a = 2.2, wl = 16, startX = -16, endX = 64, bottomY = 64;
+  let d = `M${startX},${y}`;
+  for (let x = startX; x < endX; x += wl) {
+    d += ` q${wl / 4},${-a} ${wl / 2},0 q${wl / 4},${a} ${wl / 2},0`;
+  }
+  d += ` L${endX},${bottomY} L${startX},${bottomY} Z`;
+  return d;
+}

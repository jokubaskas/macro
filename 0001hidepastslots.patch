From 667439bf8d47447a85b974b3b988533f00ffca2e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 9 Jul 2026 19:39:44 +0000
Subject: [PATCH] Hide already-passed time slots when booking for today
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

availableSlots only excluded taken/blocked/reserved slots, so a
client opening the booking calendar at 16:00 could still see and
select a 12:00 or 15:00 slot for today. Now, when the selected date
is today, slots whose start time is at or before the current time
are filtered out as well — only the rest of today and future days
remain bookable.
---
 src/BookingClient.js | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/BookingClient.js b/src/BookingClient.js
index 5ff2449..45c074a 100644
--- a/src/BookingClient.js
+++ b/src/BookingClient.js
@@ -267,9 +267,12 @@ export default function BookingClient({ user, onClose }) {
     ? recurringSlots.find(r => r.client_id === user.id && r.day_of_week === dowOf(selectedDate) && isRecurringHoldActive(selectedDate) && !myRecurringResponded(selectedDate, r.start_time)) || null
     : null;
 
+  const nowMin = new Date().getHours() * 60 + new Date().getMinutes();
+
   const availableSlots = slots.filter(s => {
     if (takenSlots.includes(s.start)) return false;
     if (selectedDate && isSlotBlocked(selectedDate, s.start, s.end)) return false;
+    if (selectedDate === today && timeToMin(s.start) <= nowMin) return false; // šiandien — tik dar nepraėję laikai
     const reserved = selectedDate ? reservedRecurringAt(selectedDate, s.start) : null;
     if (reserved) return false; // arba mano (rodoma atskirai), arba kito kliento (dar nepasibaigęs terminas)
     return true;
